inline-header {
// Always include last
#include <sawIntuitiveResearchKit/sawIntuitiveResearchKitExport.h>
}

enum {
    name teleop_PSM_type;
    namespace dvrk;
    attribute CISST_EXPORT;

    enum-value {
        name TELEOP_PSM_UNDEFINED;
        description Undefined;
        value 0;
    }
    enum-value {
        name TELEOP_PSM;
        description Native PSM teleoperation component;
    }
    enum-value {
        name TELEOP_PSM_DERIVED;
        description Component derived from native PSM teleoperation;
    }
    enum-value {
        name TELEOP_PSM_GENERIC;
        description Generic component with interfaces compatible with native teleoperation;
    }
}

enum {
    name teleop_ECM_type;
    namespace dvrk;
    attribute CISST_EXPORT;

    enum-value {
        name TELEOP_ECM_UNDEFINED;
        description Undefined;
        value 0;
    }
    enum-value {
        name TELEOP_ECM_TWO_HANDS;
        description Native two-hand ECM teleoperation component;
    }
    enum-value {
        name TELEOP_ECM_ONE_HAND;
        description Native single-hand ECM teleoperation component;
    }
    enum-value {
        name TELEOP_ECM_TWO_HANDS_DERIVED;
        description Component derived from native two-hand ECM teleoperation;
    }
    enum-value {
        name TELEOP_ECM_ONE_HAND_DERIVED;
        description Component derived from native single-hand ECM teleoperation;
    }
    enum-value {
        name TELEOP_ECM_TWO_HANDS_GENERIC;
        description Generic component with two-hand interfaces compatible with native teleoperation;
    }
    enum-value {
        name TELEOP_ECM_ONE_HAND_GENERIC;
        description Generic component with single-hand interfaces compatible with native teleoperation;
    }
}
