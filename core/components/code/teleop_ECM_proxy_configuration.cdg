// -*- Mode: C++; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*-
// ex: set filetype=cpp softtabstop=4 shiftwidth=4 tabstop=4 cindent expandtab:

inline-header {
#include <json/json.h>
#include <sawIntuitiveResearchKit/mtsIntuitiveResearchKit.h>
#include <sawIntuitiveResearchKit/teleop_type.h>
}

class {
    name teleop_ECM_proxy_configuration;
    namespace dvrk;
    attribute CISST_EXPORT;

    member {
        name type;
        type dvrk::teleop_ECM_type;
        visibility public;
        default dvrk::teleop_ECM_type::TELEOP_ECM_TWO_HANDS;
    }

    member {
        name MTM;
        type std::string;
        visibility public;
        default "";
    }

    member {
        name MTML;
        type std::string;
        visibility public;
        default "";
    }

    member {
        name MTMR;
        type std::string;
        visibility public;
        default "";
    }

    member {
        name ECM;
        type std::string;
        visibility public;
    }

    member {
        name configure_parameter;
        type Json::Value;
        visibility public;
        default Json::Value();
    }

    member {
        name period;
        type double;
        visibility public;
        default mtsIntuitiveResearchKit::TeleopPeriod;
    }

    inline-header {
    public:
        inline bool one_hand(void) const {
            return (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_ONE_HAND)
                || (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_ONE_HAND_DERIVED)
                || (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_ONE_HAND_GENERIC)
                || (!this->MTM.empty() && this->MTML.empty() && this->MTMR.empty());
        }

        inline bool two_hands(void) const {
            return !one_hand();
        }

        inline bool native(void) const {
            return (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_TWO_HANDS)
                || (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_ONE_HAND);
        }

        inline bool derived(void) const {
            return (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_TWO_HANDS_DERIVED)
                || (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_ONE_HAND_DERIVED);
        }

        inline bool generic(void) const {
            return (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_TWO_HANDS_GENERIC)
                || (this->type == dvrk::teleop_ECM_type::TELEOP_ECM_ONE_HAND_GENERIC);
        }
    }
}
